{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/audit.schema.json",
  "title": "AgentFileOps Audit Trail Entry",
  "description": "Immutable audit log entry for all operations.",
  "type": "object",
  "required": ["id", "timestamp", "actor", "operation", "risk_level", "outcome"],
  "properties": {
    "id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor": {"type": "string"},
    "operation": {"type": "string"},
    "risk_level": {"type": "string"},
    "outcome": {"type": "string", "enum": ["success", "failure", "blocked"]}
  }
}
