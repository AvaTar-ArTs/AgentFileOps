{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/result.schema.json",
  "title": "AgentFileOps Operation Result",
  "description": "Normalized result from any semantic operation.",
  "type": "object",
  "required": ["success", "operation"],
  "properties": {
    "success": {
      "type": "boolean"
    },
    "operation": {
      "type": "string"
    },
    "result": {
      "type": "object",
      "description": "Operation-specific result data"
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {"type": "string"},
        "message": {"type": "string"}
      }
    }
  }
}
