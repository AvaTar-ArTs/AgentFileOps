{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/connection.schema.json",
  "title": "AgentFileOps Connection Specification",
  "description": "Defines a remote connection with SSH/SFTP transport and credential references.",
  "type": "object",
  "required": ["id", "transport"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique connection identifier"
    },
    "transport": {
      "$ref": "ssh-transport.schema.json"
    }
  }
}
