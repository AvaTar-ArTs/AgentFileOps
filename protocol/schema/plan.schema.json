{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/plan.schema.json",
  "title": "AgentFileOps Operation Plan",
  "description": "Preflight plan for replacement, destructive, or high-impact AgentFileOps remote file operations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["plan_id", "operation", "risk_level", "created_at", "expires_at", "fingerprint", "actions"],
  "properties": {
    "plan_id": {"type": "string", "minLength": 1},
    "operation": {"type": "string"},
    "risk_level": {"enum": [0, 1, 2, 3, 4]},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "fingerprint": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "actions": {"type": "array", "items": {"type": "object", "additionalProperties": true}},
    "files": {"type": "integer", "minimum": 0},
    "directories": {"type": "integer", "minimum": 0},
    "estimated_bytes": {"type": "integer", "minimum": 0},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "symlinks": {"type": "array", "items": {"type": "object"}},
    "strategy": {"type": "string"},
    "target_snapshot": {"type": "object", "additionalProperties": true}
  }
}
