{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/plan.schema.json",
  "title": "AgentFileOps Operation Plan",
  "description": "Preflight plan for high-risk operations with snapshots and expirations.",
  "type": "object",
  "required": ["plan_id", "operation", "risk_level"],
  "properties": {
    "plan_id": {
      "type": "string",
      "description": "Unique plan identifier"
    },
    "operation": {
      "type": "string",
      "description": "Operation being planned"
    },
    "risk_level": {
      "type": "string",
      "enum": ["level_0", "level_1", "level_2", "level_3", "level_4"]
    },
    "target_snapshot": {
      "type": "string",
      "description": "Fingerprint of target state before execution"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Plan expiration timestamp"
    }
  }
}
