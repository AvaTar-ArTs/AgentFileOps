{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/ssh-transport.schema.json",
  "title": "AgentFileOps SSH Transport",
  "description": "SSH/SFTP transport configuration with security constraints.",
  "type": "object",
  "required": ["host", "port", "known_hosts_ref", "credential_ref"],
  "properties": {
    "host": {"type": "string"},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535, "default": 22},
    "username": {"type": "string"},
    "known_hosts_ref": {"type": "string", "description": "Reference to known_hosts store (no embedded keys)"},
    "credential_ref": {"type": "string", "description": "Reference to credential store (no embedded secrets)"},
    "inline_read_bytes": {
      "type": "object",
      "properties": {
        "default": {"type": "integer", "default": 1048576},
        "maximum": {"type": "integer", "default": 16777216}
      },
      "required": ["default", "maximum"]
    }
  }
}
