{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/operation.schema.json",
  "title": "AgentFileOps Operation",
  "description": "Canonical semantic remote file operation. Public operations never contain arbitrary shell command execution.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation"],
  "properties": {
    "operation": {
      "enum": [
        "connections", "list", "stat", "find", "read", "write", "transfer",
        "mkdir", "touch", "rename", "move", "copy", "chmod", "symlink", "delete",
        "archive.inspect", "archive.create", "archive.extract", "sync"
      ]
    },
    "source": {"$ref": "path.schema.json"},
    "destination": {"$ref": "path.schema.json"},
    "target": {"$ref": "path.schema.json"},
    "dry_run": {"type": "boolean", "default": false},
    "overwrite": {"type": "boolean", "default": false},
    "delete": {"type": "boolean", "default": false},
    "options": {"type": "object", "additionalProperties": true}
  }
}
