{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/operation.schema.json",
  "title": "AgentFileOps Operation",
  "description": "Semantic file operation with risk classification. No arbitrary shell operations.",
  "type": "object",
  "required": ["operation"],
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "list",
        "stat",
        "find",
        "read",
        "checksum",
        "mkdir",
        "write",
        "copy-new",
        "copy-overwrite",
        "move",
        "chmod",
        "symlink",
        "delete",
        "recursive-delete",
        "transfer",
        "sync",
        "sync-delete",
        "archive",
        "extract"
      ],
      "description": "Semantic operation name. Forbidden: exec, shell, command, run_command, ssh_exec"
    }
  }
}
