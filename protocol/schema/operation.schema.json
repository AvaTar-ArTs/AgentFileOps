{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://agentfs.dev/schema/0.1/operation.schema.json",
  "title":"AgentFS Operation",
  "type":"object",
  "additionalProperties":false,
  "required":["operation"],
  "properties":{
    "operation":{"enum":["connections","list","stat","find","read","write","transfer","mkdir","touch","rename","move","copy","chmod","symlink","delete","archive.inspect","archive.create","archive.extract","sync"]},
    "source":{"$ref":"path.schema.json"},
    "destination":{"$ref":"path.schema.json"},
    "target":{"$ref":"path.schema.json"},
    "dry_run":{"type":"boolean","default":false},
    "overwrite":{"type":"boolean","default":false},
    "delete":{"type":"boolean","default":false},
    "options":{"type":"object","additionalProperties":true}
  }
}