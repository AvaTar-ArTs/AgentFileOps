{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/path.schema.json",
  "title": "AgentFileOps Path Specification",
  "description": "Path normalization with base selection and symlink semantics.",
  "type": "object",
  "required": ["base", "path", "follow_symlinks"],
  "properties": {
    "base": {
      "type": "string",
      "enum": ["home", "absolute", "root"],
      "description": "Base path context for relative resolution"
    },
    "path": {
      "type": "string",
      "description": "Path relative to base or absolute"
    },
    "follow_symlinks": {
      "type": "boolean",
      "default": false,
      "description": "Explicitly control symlink following behavior"
    }
  }
}
