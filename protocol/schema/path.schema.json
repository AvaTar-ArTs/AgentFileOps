{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/AvaTar-ArTs/AgentFileOps/main/protocol/schema/path.schema.json",
  "title": "AgentFileOps PathSpec",
  "description": "Logical AgentFileOps path identity for home-, alias-, or explicit absolute-path operations.",
  "type": "object",
  "additionalProperties": false,
  "required": ["connection", "base", "path"],
  "properties": {
    "connection": {"type": "string", "minLength": 1},
    "base": {"type": "string", "minLength": 1},
    "path": {"type": "string"},
    "follow_symlinks": {"type": "boolean", "default": false}
  },
  "allOf": [
    {
      "if": {"properties": {"base": {"const": "absolute"}}, "required": ["base"]},
      "then": {"properties": {"path": {"pattern": "^/"}}}
    }
  ]
}
